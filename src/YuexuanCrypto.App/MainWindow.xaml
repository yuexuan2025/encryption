<Window x:Class="YuexuanCrypto.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:YuexuanCrypto.App.ViewModels"
        Title="文件加密"
        Height="780" Width="1100"
        MinHeight="700" MinWidth="980"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        AllowDrop="True"
        Drop="OnDrop"
        DragOver="OnDragOver">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="24">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,16">
            <TextBlock Text="文件加密"
                       FontSize="26" FontWeight="SemiBold"
                       Foreground="{StaticResource InkBrush}"
                       VerticalAlignment="Center"/>
            <TextBlock DockPanel.Dock="Right"
                       Text="yuexuan"
                       FontSize="12"
                       Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center"
                       Margin="12,6,4,0"
                       Opacity="0.85"
                       Cursor="Hand"
                       MouseLeftButtonUp="OnAboutClick"
                       ToolTip="关于"/>
        </DockPanel>

        <!-- 双栏：左加密 / 右解密，始终展开 -->
        <Grid Grid.Row="1">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- ========== 加密 ========== -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="加密打包"
                               FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}"
                               Margin="0,0,0,12"/>

                    <DockPanel Grid.Row="1" Margin="0,0,0,8">
                        <TextBlock Text="{Binding ItemsSummary}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"/>
                        <TextBlock DockPanel.Dock="Right"
                                   Text="把文件/文件夹拖到下方列表"
                                   FontSize="11"
                                   Foreground="{StaticResource MutedBrush}"
                                   Opacity="0.8"/>
                    </DockPanel>

                    <!-- 可滚动主体：小窗口也保证「开始加密」始终可见 -->
                    <ScrollViewer Grid.Row="2"
                                  VerticalScrollBarVisibility="Auto"
                                  HorizontalScrollBarVisibility="Disabled">
                        <StackPanel>
                            <Border BorderBrush="{StaticResource BorderBrush}"
                                    BorderThickness="1"
                                    CornerRadius="8"
                                    Background="#FAFBFC"
                                    MinHeight="160"
                                    Margin="0,0,0,10">
                                <Grid>
                                    <ListBox x:Name="EncryptList"
                                             ItemsSource="{Binding EncryptItems}"
                                             BorderThickness="0"
                                             Background="Transparent"
                                             Padding="4"
                                             MaxHeight="220"
                                             VirtualizingPanel.IsVirtualizing="True"
                                             VirtualizingPanel.VirtualizationMode="Recycling">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="2,4">
                                                    <Grid.ColumnDefinitions>
                                                        <ColumnDefinition Width="28"/>
                                                        <ColumnDefinition Width="*"/>
                                                        <ColumnDefinition Width="Auto"/>
                                                        <ColumnDefinition Width="40"/>
                                                    </Grid.ColumnDefinitions>
                                                    <TextBlock Grid.Column="0" FontSize="15" VerticalAlignment="Center">
                                                        <TextBlock.Style>
                                                            <Style TargetType="TextBlock">
                                                                <Setter Property="Text" Value="📄"/>
                                                                <Style.Triggers>
                                                                    <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                                        <Setter Property="Text" Value="📁"/>
                                                                    </DataTrigger>
                                                                </Style.Triggers>
                                                            </Style>
                                                        </TextBlock.Style>
                                                    </TextBlock>
                                                    <TextBlock Grid.Column="1"
                                                               Text="{Binding RelativePath}"
                                                               VerticalAlignment="Center"
                                                               FontSize="13"
                                                               TextTrimming="CharacterEllipsis"
                                                               Foreground="{StaticResource InkBrush}"/>
                                                    <TextBlock Grid.Column="2"
                                                               Text="{Binding SizeText}"
                                                               VerticalAlignment="Center"
                                                               FontSize="12"
                                                               Margin="8,0"
                                                               Foreground="{StaticResource MutedBrush}"/>
                                                    <Button Grid.Column="3"
                                                            Content="✕"
                                                            Width="32" Height="28"
                                                            Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                            CommandParameter="{Binding}"
                                                            Style="{StaticResource GhostButton}"
                                                            Padding="0"
                                                            FontSize="12"/>
                                                </Grid>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                    <TextBlock Text="将文件或文件夹拖到此处"
                                               TextAlignment="Center"
                                               HorizontalAlignment="Center"
                                               VerticalAlignment="Center"
                                               FontSize="13"
                                               Foreground="{StaticResource MutedBrush}"
                                               IsHitTestVisible="False">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding EncryptItems.Count}" Value="0">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </Grid>
                            </Border>

                            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                                <Button Content="添加文件" Command="{Binding AddFilesCommand}"
                                        Style="{StaticResource SecondaryButton}" MinWidth="96" Height="36" Margin="0,0,8,0"/>
                                <Button Content="添加文件夹" Command="{Binding AddFolderCommand}"
                                        Style="{StaticResource SecondaryButton}" MinWidth="96" Height="36" Margin="0,0,8,0"/>
                                <Button Content="清空" Command="{Binding ClearItemsCommand}"
                                        Style="{StaticResource GhostButton}" MinWidth="72" Height="36"/>
                            </StackPanel>

                            <TextBlock Text="密码" Style="{StaticResource FieldLabel}"/>
                            <DockPanel>
                                <Button DockPanel.Dock="Right"
                                        Content="{Binding ShowEncPasswordGlyph}"
                                        Width="40" Height="40"
                                        Margin="8,0,0,0"
                                        Background="Transparent" BorderThickness="0"
                                        Cursor="Hand" ToolTip="显示/隐藏密码"
                                        Command="{Binding ToggleShowEncPasswordCommand}"/>
                                <Grid>
                                    <PasswordBox x:Name="EncPwdBox" Height="40" FontSize="14"
                                                 PasswordChanged="OnEncPasswordChanged"/>
                                    <TextBox x:Name="EncPwdVisibleBox" Height="40" FontSize="14"
                                             Padding="10,8" VerticalContentAlignment="Center"
                                             Visibility="Collapsed"
                                             TextChanged="OnEncPasswordVisibleChanged"/>
                                </Grid>
                            </DockPanel>

                            <DockPanel Margin="0,6,0,4">
                                <TextBlock Text="{Binding PasswordStrength}" FontSize="12"
                                           Foreground="{StaticResource MutedBrush}" DockPanel.Dock="Right"/>
                                <TextBlock Text="忘记密码后将无法解密文件，请务必牢记"
                                           Foreground="{StaticResource DangerBrush}" FontSize="11"/>
                            </DockPanel>
                            <Grid Height="4" Margin="0,0,0,10">
                                <Border Background="#E5E7EB" CornerRadius="2"/>
                                <Border HorizontalAlignment="Left" CornerRadius="2"
                                        Height="4"
                                        Width="{Binding StrengthBarWidth}"
                                        Background="{Binding StrengthBarColor}"/>
                            </Grid>

                            <StackPanel Visibility="{Binding WeakWarningVisible}">
                                <Border Background="#FEF2F2" CornerRadius="8" Padding="10,8" Margin="0,0,0,10">
                                    <TextBlock Text="当前密码强度较弱，建议使用更长的混合密码。"
                                               Foreground="{StaticResource DangerBrush}" FontSize="12" TextWrapping="Wrap"/>
                                </Border>
                            </StackPanel>

                            <TextBlock Text="确认密码" Style="{StaticResource FieldLabel}"/>
                            <PasswordBox x:Name="EncConfirmBox" Height="40" FontSize="14"
                                         PasswordChanged="OnEncConfirmChanged" Margin="0,0,0,10"/>

                            <TextBlock Text="密码提示（可选）" Style="{StaticResource FieldLabel}"/>
                            <TextBox Height="40" FontSize="13" Padding="10,8"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding EncHint, UpdateSourceTrigger=PropertyChanged}"/>
                            <TextBlock Text="提示将混淆保存在文件中，有本软件可查看。请勿直接写密码。"
                                       FontSize="11" Foreground="{StaticResource MutedBrush}"
                                       TextWrapping="Wrap" Margin="0,4,0,10"/>

                            <TextBlock Text="保存位置" Style="{StaticResource FieldLabel}"/>
                            <DockPanel Margin="0,0,0,8">
                                <Button DockPanel.Dock="Right" Content="浏览"
                                        Command="{Binding BrowseEncOutputCommand}"
                                        Style="{StaticResource SecondaryButton}"
                                        MinWidth="72" Height="40" Margin="8,0,0,0"/>
                                <TextBox Height="40" FontSize="13" Padding="10,8"
                                         VerticalContentAlignment="Center"
                                         Text="{Binding EncOutputPath, UpdateSourceTrigger=PropertyChanged}"/>
                            </DockPanel>
                        </StackPanel>
                    </ScrollViewer>

                    <Button Grid.Row="3"
                            Content="开始加密"
                            Command="{Binding EncryptCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Height="44" FontSize="15"
                            HorizontalAlignment="Stretch"
                            Margin="0,8,0,0"/>
                </Grid>
            </Border>

            <!-- ========== 解密 ========== -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <TextBlock Grid.Row="0"
                               Text="解密还原"
                               FontSize="17" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}"
                               Margin="0,0,0,12"/>

                    <TextBlock Grid.Row="1" Text="选择加密文件（.yuexuan）" Style="{StaticResource FieldLabel}"/>
                    <DockPanel Grid.Row="2" Margin="0,0,0,12">
                        <Button DockPanel.Dock="Right" Content="浏览"
                                Command="{Binding BrowseDecContainerCommand}"
                                Style="{StaticResource SecondaryButton}"
                                MinWidth="72" Height="40" Margin="8,0,0,0"/>
                        <TextBox Height="40" FontSize="13" Padding="10,8"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding DecContainerPath, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>

                    <Border Grid.Row="3" Background="#EEF2FF" CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Content="显示"
                                    MinWidth="56" Height="28"
                                    Style="{StaticResource SecondaryButton}"
                                    Command="{Binding RevealHintCommand}"
                                    Visibility="{Binding DecHintToggleVisible}"
                                    Margin="8,0,0,0"/>
                            <TextBlock Text="{Binding DecHint}"
                                       Foreground="{StaticResource AccentBrush}"
                                       FontSize="12" TextWrapping="Wrap"
                                       VerticalAlignment="Center"/>
                        </DockPanel>
                    </Border>

                    <TextBlock Grid.Row="4" Text="密码" Style="{StaticResource FieldLabel}"/>
                    <DockPanel Grid.Row="5">
                        <Button DockPanel.Dock="Right"
                                Content="{Binding ShowDecPasswordGlyph}"
                                Width="40" Height="40"
                                Margin="8,0,0,0"
                                Background="Transparent" BorderThickness="0"
                                Cursor="Hand" ToolTip="显示/隐藏密码"
                                Command="{Binding ToggleShowDecPasswordCommand}"/>
                        <Grid>
                            <PasswordBox x:Name="DecPwdBox" Height="40" FontSize="14"
                                         PasswordChanged="OnDecPasswordChanged"/>
                            <TextBox x:Name="DecPwdVisibleBox" Height="40" FontSize="14"
                                     Padding="10,8" VerticalContentAlignment="Center"
                                     Visibility="Collapsed"
                                     TextChanged="OnDecPasswordVisibleChanged"/>
                        </Grid>
                    </DockPanel>

                    <TextBlock Grid.Row="6"
                               Text="忘记密码后将无法解密文件，请务必牢记"
                               Foreground="{StaticResource DangerBrush}" FontSize="11"
                               Margin="0,6,0,16"/>

                    <StackPanel Grid.Row="7">
                        <TextBlock Text="解密到文件夹" Style="{StaticResource FieldLabel}"/>
                        <DockPanel Margin="0,0,0,12">
                            <Button DockPanel.Dock="Right" Content="浏览"
                                    Command="{Binding BrowseDecTargetCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    MinWidth="72" Height="40" Margin="8,0,0,0"/>
                            <TextBox Height="40" FontSize="13" Padding="10,8"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding DecTargetFolder, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                        <TextBlock Text="同名文件会询问：覆盖 / 跳过 / 自动改名"
                                   FontSize="11" Foreground="{StaticResource MutedBrush}"
                                   TextWrapping="Wrap" Margin="0,0,0,8"/>
                    </StackPanel>

                    <Button Grid.Row="8"
                            Content="开始解密"
                            Command="{Binding DecryptCommand}"
                            Style="{StaticResource PrimaryButton}"
                            Height="44" FontSize="15"
                            HorizontalAlignment="Stretch"
                            Margin="0,12,0,0"/>
                </Grid>
            </Border>
        </Grid>

        <!-- 进度 -->
        <Border Grid.Row="2" Style="{StaticResource Card}" Margin="0,14,0,0">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <StackPanel Grid.Column="0" Margin="0,0,12,0">
                    <DockPanel Margin="0,0,0,8">
                        <TextBlock Text="{Binding StatusText}" FontSize="13" FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}"/>
                        <TextBlock DockPanel.Dock="Right" Text="{Binding ProgressText}"
                                   FontSize="12" Foreground="{StaticResource MutedBrush}"/>
                    </DockPanel>
                    <ProgressBar Height="10" Minimum="0" Maximum="100"
                                 Value="{Binding ProgressPercent}"
                                 IsIndeterminate="{Binding IsIndeterminate}"
                                 Foreground="{StaticResource AccentBrush}"
                                 Background="#E5E7EB" BorderThickness="0"/>
                    <DockPanel Margin="0,8,0,0">
                        <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}"
                                   Text="{Binding CurrentItem}" TextTrimming="CharacterEllipsis"/>
                        <TextBlock DockPanel.Dock="Right" HorizontalAlignment="Right"
                                   FontSize="12" Foreground="{StaticResource MutedBrush}">
                            <Run Text="{Binding SpeedText, Mode=OneWay}"/>
                            <Run Text="  "/>
                            <Run Text="{Binding EtaText, Mode=OneWay}"/>
                        </TextBlock>
                    </DockPanel>
                </StackPanel>
                <Button Grid.Column="1"
                        Content="取消"
                        Command="{Binding CancelCommand}"
                        Style="{StaticResource GhostButton}"
                        MinWidth="96" Height="44"
                        VerticalAlignment="Center"/>
            </Grid>
        </Border>

        <!-- Footer -->
        <DockPanel Grid.Row="3" Margin="0,10,0,0">
            <TextBlock Text="仅在本机处理，不联网、不上传。原文件不会被修改。"
                       FontSize="11" Foreground="{StaticResource MutedBrush}"/>
            <TextBlock DockPanel.Dock="Right" Text="yuexuan"
                       FontSize="11" Foreground="{StaticResource MutedBrush}" Opacity="0.7"/>
        </DockPanel>
    </Grid>
</Window>
