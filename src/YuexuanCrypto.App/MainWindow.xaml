<Window x:Class="YuexuanCrypto.App.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:YuexuanCrypto.App.ViewModels"
        Title="文件加密"
        Height="720" Width="960"
        MinHeight="600" MinWidth="820"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgBrush}"
        AllowDrop="True"
        Drop="OnDrop"
        DragOver="OnDragOver">
    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Grid Margin="28">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Header -->
        <DockPanel Grid.Row="0" Margin="0,0,0,20">
            <TextBlock Text="文件加密"
                       FontSize="28" FontWeight="SemiBold"
                       Foreground="{StaticResource InkBrush}"
                       VerticalAlignment="Center"/>
            <TextBlock DockPanel.Dock="Right"
                       Text="yuexuan"
                       FontSize="12"
                       Foreground="{StaticResource MutedBrush}"
                       VerticalAlignment="Center"
                       Margin="12,8,8,0"
                       Opacity="0.85"
                       Cursor="Hand"
                       MouseLeftButtonUp="OnAboutClick"
                       ToolTip="关于"/>
        </DockPanel>

        <!-- Mode switch -->
        <StackPanel Grid.Row="1" Orientation="Horizontal" Margin="0,0,0,16">
            <Border Style="{StaticResource Card}" Padding="4" CornerRadius="10" Background="#FFFFFF">
                <StackPanel Orientation="Horizontal">
                    <RadioButton Content="加密打包"
                                 IsChecked="{Binding IsEncryptMode}"
                                 GroupName="Mode"
                                 Margin="8,8,4,8"
                                 FontSize="14" FontWeight="SemiBold"
                                 Foreground="{StaticResource AccentBrush}"/>
                    <RadioButton Content="解密还原"
                                 IsChecked="{Binding IsDecryptMode}"
                                 GroupName="Mode"
                                 Margin="16,8,8,8"
                                 FontSize="14" FontWeight="SemiBold"
                                 Foreground="{StaticResource AccentBrush}"/>
                </StackPanel>
            </Border>
        </StackPanel>

        <!-- Main content -->
        <Grid Grid.Row="2">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="1.2*"/>
                <ColumnDefinition Width="16"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Left: files / container -->
            <Border Grid.Column="0" Style="{StaticResource Card}">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto"/>
                        <RowDefinition Height="*"/>
                        <RowDefinition Height="Auto"/>
                    </Grid.RowDefinitions>

                    <DockPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock x:Name="ListTitle"
                                   FontSize="15" FontWeight="SemiBold"
                                   Foreground="{StaticResource InkBrush}"
                                   Text="待加密项目"/>
                        <TextBlock DockPanel.Dock="Right"
                                   Text="{Binding ItemsSummary}"
                                   FontSize="12"
                                   VerticalAlignment="Center"
                                   Foreground="{StaticResource MutedBrush}"/>
                    </DockPanel>

                    <Border Grid.Row="1"
                            BorderBrush="{StaticResource BorderBrush}"
                            BorderThickness="1"
                            CornerRadius="8"
                            Background="#FAFBFC"
                            MinHeight="220">
                        <Grid>
                            <ListBox x:Name="ItemList"
                                     ItemsSource="{Binding Items}"
                                     BorderThickness="0"
                                     Background="Transparent"
                                     Padding="4"
                                     VirtualizingPanel.IsVirtualizing="True"
                                     VirtualizingPanel.VirtualizationMode="Recycling"
                                     ScrollViewer.CanContentScroll="True"
                                     VirtualizingPanel.ScrollUnit="Pixel">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <Grid Margin="4,6">
                                            <Grid.ColumnDefinitions>
                                                <ColumnDefinition Width="28"/>
                                                <ColumnDefinition Width="*"/>
                                                <ColumnDefinition Width="Auto"/>
                                                <ColumnDefinition Width="36"/>
                                            </Grid.ColumnDefinitions>
                                            <TextBlock Grid.Column="0" FontSize="16" VerticalAlignment="Center">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text" Value="📄"/>
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding IsDirectory}" Value="True">
                                                                <Setter Property="Text" Value="📁"/>
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                            <TextBlock Grid.Column="1"
                                                       Text="{Binding RelativePath}"
                                                       VerticalAlignment="Center"
                                                       FontSize="13"
                                                       TextTrimming="CharacterEllipsis"
                                                       Foreground="{StaticResource InkBrush}"/>
                                            <TextBlock Grid.Column="2"
                                                       Text="{Binding SizeText}"
                                                       VerticalAlignment="Center"
                                                       FontSize="12"
                                                       Margin="8,0"
                                                       Foreground="{StaticResource MutedBrush}"/>
                                            <Button Grid.Column="3"
                                                    Content="✕"
                                                    Command="{Binding DataContext.RemoveItemCommand, RelativeSource={RelativeSource AncestorType=Window}}"
                                                    CommandParameter="{Binding}"
                                                    Style="{StaticResource GhostButton}"
                                                    Padding="6,2"
                                                    FontSize="12"
                                                    Visibility="{Binding DataContext.IsEncryptMode, RelativeSource={RelativeSource AncestorType=Window}, Converter={x:Null}}"/>
                                        </Grid>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>

                            <TextBlock x:Name="DropHint"
                                       Text="将文件或文件夹拖到此处&#x0a;或使用下方按钮添加"
                                       TextAlignment="Center"
                                       HorizontalAlignment="Center"
                                       VerticalAlignment="Center"
                                       FontSize="14"
                                       Foreground="{StaticResource MutedBrush}"
                                       IsHitTestVisible="False"
                                       LineHeight="24">
                                <TextBlock.Style>
                                    <Style TargetType="TextBlock">
                                        <Style.Triggers>
                                            <DataTrigger Binding="{Binding Items.Count}" Value="0">
                                                <Setter Property="Visibility" Value="Visible"/>
                                            </DataTrigger>
                                            <DataTrigger Binding="{Binding IsEncryptMode}" Value="False">
                                                <Setter Property="Text" Value="使用右侧「浏览」选择 .yuexuan 文件&#x0a;或将文件拖到此处"/>
                                            </DataTrigger>
                                        </Style.Triggers>
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </Style>
                                </TextBlock.Style>
                            </TextBlock>
                        </Grid>
                    </Border>

                    <StackPanel Grid.Row="2" Orientation="Horizontal" Margin="0,12,0,0">
                        <Button Content="添加文件"
                                Command="{Binding AddFilesCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0"/>
                        <Button Content="添加文件夹"
                                Command="{Binding AddFolderCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Margin="0,0,8,0"/>
                        <Button Content="清空"
                                Command="{Binding ClearItemsCommand}"
                                Style="{StaticResource GhostButton}"/>
                        <Button Content="选择 .yuexuan"
                                Command="{Binding BrowseContainerCommand}"
                                Margin="8,0,0,0">
                            <Button.Style>
                                <Style TargetType="Button" BasedOn="{StaticResource SecondaryButton}">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding IsDecryptMode}" Value="False">
                                            <Setter Property="Visibility" Value="Collapsed"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Button.Style>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <!-- Right: password / options -->
            <Border Grid.Column="2" Style="{StaticResource Card}">
                <StackPanel>
                    <TextBlock Text="密码设置" FontSize="15" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}" Margin="0,0,0,16"/>

                    <TextBlock Text="密码" Style="{StaticResource FieldLabel}"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Content="{Binding ShowPasswordGlyph}"
                                Width="40" Height="40"
                                Padding="0"
                                Margin="8,0,0,0"
                                Background="Transparent"
                                BorderThickness="0"
                                Cursor="Hand"
                                ToolTip="显示/隐藏密码"
                                Command="{Binding ToggleShowPasswordCommand}"/>
                        <Grid>
                            <PasswordBox x:Name="PwdBox"
                                         Height="40"
                                         FontSize="14"
                                         PasswordChanged="OnPasswordChanged"/>
                            <TextBox x:Name="PwdVisibleBox"
                                     Height="40"
                                     FontSize="14"
                                     Padding="10,8"
                                     VerticalContentAlignment="Center"
                                     Visibility="Collapsed"
                                     TextChanged="OnPasswordVisibleChanged"/>
                        </Grid>
                    </DockPanel>
                    <DockPanel Margin="0,6,0,4">
                        <TextBlock Text="{Binding PasswordStrength}"
                                   Foreground="{StaticResource MutedBrush}"
                                   FontSize="12"
                                   DockPanel.Dock="Right"/>
                        <TextBlock Text="忘记密码后将无法解密文件，请务必牢记"
                                   Foreground="{StaticResource DangerBrush}"
                                   FontSize="11"/>
                    </DockPanel>
                    <!-- 密码强度条 -->
                    <Grid Height="4" Margin="0,0,0,12">
                        <Border Background="#E5E7EB" CornerRadius="2"/>
                        <Border x:Name="StrengthBar"
                                HorizontalAlignment="Left"
                                CornerRadius="2"
                                Width="0"
                                Background="#93C5FD">
                            <Border.Style>
                                <Style TargetType="Border">
                                    <Style.Triggers>
                                        <DataTrigger Binding="{Binding PasswordStrength}" Value="弱">
                                            <Setter Property="Background" Value="#F87171"/>
                                            <Setter Property="Width" Value="40"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PasswordStrength}" Value="中">
                                            <Setter Property="Background" Value="#FBBF24"/>
                                            <Setter Property="Width" Value="80"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PasswordStrength}" Value="强">
                                            <Setter Property="Background" Value="#34D399"/>
                                            <Setter Property="Width" Value="120"/>
                                        </DataTrigger>
                                        <DataTrigger Binding="{Binding PasswordStrength}" Value="很强">
                                            <Setter Property="Background" Value="#059669"/>
                                            <Setter Property="Width" Value="160"/>
                                        </DataTrigger>
                                    </Style.Triggers>
                                </Style>
                            </Border.Style>
                        </Border>
                    </Grid>

                    <StackPanel Visibility="{Binding WeakWarningVisible}">
                        <Border Background="#FEF2F2" CornerRadius="8" Padding="10,8" Margin="0,0,0,12">
                            <TextBlock Text="当前密码强度较弱，建议使用更长的混合密码。"
                                       Foreground="{StaticResource DangerBrush}"
                                       FontSize="12"
                                       TextWrapping="Wrap"/>
                        </Border>
                    </StackPanel>

                    <TextBlock x:Name="ConfirmLabel" Text="确认密码" Style="{StaticResource FieldLabel}"/>
                    <PasswordBox x:Name="ConfirmBox"
                                 Height="40"
                                 FontSize="14"
                                 PasswordChanged="OnConfirmChanged"/>

                    <TextBlock x:Name="HintLabel" Text="密码提示（可选）" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                    <TextBox x:Name="HintBox"
                             Height="40"
                             FontSize="13"
                             Padding="10,8"
                             VerticalContentAlignment="Center"
                             Text="{Binding Hint, UpdateSourceTrigger=PropertyChanged}">
                        <TextBox.Style>
                            <Style TargetType="TextBox">
                                <Setter Property="Visibility" Value="Visible"/>
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsDecryptMode}" Value="True">
                                        <Setter Property="Visibility" Value="Collapsed"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </TextBox.Style>
                    </TextBox>
                    <TextBlock x:Name="HintHelp"
                               Text="提示将以混淆方式保存在文件中，有本软件即可查看。请勿直接写密码本身。"
                               FontSize="11"
                               Foreground="{StaticResource MutedBrush}"
                               TextWrapping="Wrap"
                               Margin="0,6,0,0"/>

                    <TextBlock x:Name="OutputLabel" Text="保存位置" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                    <DockPanel>
                        <Button DockPanel.Dock="Right"
                                Content="浏览"
                                Command="{Binding BrowseOutputCommand}"
                                Style="{StaticResource SecondaryButton}"
                                Margin="8,0,0,0"/>
                        <TextBox Height="40" FontSize="13" Padding="10,8"
                                 VerticalContentAlignment="Center"
                                 Text="{Binding OutputPath, UpdateSourceTrigger=PropertyChanged}"/>
                    </DockPanel>

                    <StackPanel Visibility="{Binding IsDecryptMode}">
                        <TextBlock Text="解密到" Style="{StaticResource FieldLabel}" Margin="0,16,0,6"/>
                        <DockPanel>
                            <Button DockPanel.Dock="Right"
                                    Content="浏览"
                                    Command="{Binding BrowseTargetCommand}"
                                    Style="{StaticResource SecondaryButton}"
                                    Margin="8,0,0,0"/>
                            <TextBox Height="40" FontSize="13" Padding="10,8"
                                     VerticalContentAlignment="Center"
                                     Text="{Binding TargetFolder, UpdateSourceTrigger=PropertyChanged}"/>
                        </DockPanel>
                    </StackPanel>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Progress -->
        <Border Grid.Row="3" Style="{StaticResource Card}" Margin="0,16,0,0">
            <StackPanel>
                <DockPanel Margin="0,0,0,8">
                    <TextBlock Text="{Binding StatusText}"
                               FontSize="13" FontWeight="SemiBold"
                               Foreground="{StaticResource InkBrush}"/>
                    <TextBlock DockPanel.Dock="Right"
                               Text="{Binding ProgressText}"
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}"/>
                </DockPanel>
                <ProgressBar Height="10"
                             Minimum="0" Maximum="100"
                             Value="{Binding ProgressPercent}"
                             IsIndeterminate="{Binding IsIndeterminate}"
                             Foreground="{StaticResource AccentBrush}"
                             Background="#E5E7EB"
                             BorderThickness="0"/>
                <DockPanel Margin="0,8,0,0">
                    <TextBlock FontSize="12" Foreground="{StaticResource MutedBrush}"
                               Text="{Binding CurrentItem}"
                               TextTrimming="CharacterEllipsis"/>
                    <TextBlock DockPanel.Dock="Right"
                               HorizontalAlignment="Right"
                               FontSize="12"
                               Foreground="{StaticResource MutedBrush}">
                        <Run Text="{Binding SpeedText, Mode=OneWay}"/>
                        <Run Text="  "/>
                        <Run Text="{Binding EtaText, Mode=OneWay}"/>
                    </TextBlock>
                </DockPanel>
            </StackPanel>
        </Border>

        <!-- Actions -->
        <DockPanel Grid.Row="4" Margin="0,16,0,0">
            <Button DockPanel.Dock="Right"
                    Content="{Binding PrimaryActionText}"
                    Command="{Binding PrimaryCommand}"
                    Style="{StaticResource PrimaryButton}"
                    MinWidth="160"
                    Height="44"
                    FontSize="15"/>
            <Button Content="取消"
                    Command="{Binding CancelCommand}"
                    Style="{StaticResource GhostButton}"
                    HorizontalAlignment="Left"
                    Height="44"
                    MinWidth="100"/>
        </DockPanel>

        <!-- Footer -->
        <DockPanel Grid.Row="5" Margin="0,12,0,0">
            <TextBlock Text="仅在本机处理，不联网、不上传。原文件不会被修改。"
                       FontSize="11"
                       Foreground="{StaticResource MutedBrush}"/>
            <TextBlock DockPanel.Dock="Right"
                       Text="yuexuan"
                       FontSize="11"
                       Foreground="{StaticResource MutedBrush}"
                       Opacity="0.7"/>
        </DockPanel>
    </Grid>
</Window>
