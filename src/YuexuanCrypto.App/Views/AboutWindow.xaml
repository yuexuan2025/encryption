<Window x:Class="YuexuanCrypto.App.AboutWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="关于"
        Width="420" Height="280"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource BgBrush}">
    <Grid Margin="28">
        <StackPanel VerticalAlignment="Center" HorizontalAlignment="Center">
            <TextBlock Text="文件加密"
                       FontSize="22" FontWeight="SemiBold"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource InkBrush}"/>
            <TextBlock Text="将文件打包为 .yuexuan 加密容器"
                       FontSize="13"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}"/>
            <Separator Margin="0,20,0,16" Background="{StaticResource BorderBrush}"/>
            <TextBlock Text="作者  yuexuan"
                       FontSize="13"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource InkBrush}"/>
            <TextBlock Text="版本  1.0.0"
                       FontSize="12"
                       Margin="0,8,0,0"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}"/>
            <TextBlock Text="本机处理，不联网、不上传、无遥测"
                       FontSize="11"
                       Margin="0,16,0,0"
                       HorizontalAlignment="Center"
                       Foreground="{StaticResource MutedBrush}"/>
            <Button Content="关闭"
                    Style="{StaticResource PrimaryButton}"
                    MinWidth="100"
                    Margin="0,20,0,0"
                    HorizontalAlignment="Center"
                    Click="OnClick"/>
        </StackPanel>
    </Grid>
</Window>
