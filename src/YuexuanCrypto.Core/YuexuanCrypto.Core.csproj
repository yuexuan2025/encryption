<Project Sdk="Microsoft.NET.Sdk">

  <PropertyGroup>
    <TargetFramework>net9.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
    <LangVersion>latest</LangVersion>
    <RootNamespace>YuexuanCrypto.Core</RootNamespace>
    <AssemblyName>YuexuanCrypto.Core</AssemblyName>
    <TreatWarningsAsErrors>false</TreatWarningsAsErrors>
    <GenerateDocumentationFile>false</GenerateDocumentationFile>
  </PropertyGroup>

  <ItemGroup>
    <Reference Include="Isopoh.Cryptography.Argon2">
      <HintPath>..\..\lib\Isopoh.Cryptography.Argon2.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Isopoh.Cryptography.Blake2b">
      <HintPath>..\..\lib\Isopoh.Cryptography.Blake2b.dll</HintPath>
      <Private>true</Private>
    </Reference>
    <Reference Include="Isopoh.Cryptography.SecureArray">
      <HintPath>..\..\lib\Isopoh.Cryptography.SecureArray.dll</HintPath>
      <Private>true</Private>
    </Reference>
  </ItemGroup>

  <Target Name="CopyArgon2Deps" AfterTargets="Build">
    <Copy SourceFiles="..\..\lib\Isopoh.Cryptography.Argon2.dll;..\..\lib\Isopoh.Cryptography.Blake2b.dll;..\..\lib\Isopoh.Cryptography.SecureArray.dll"
          DestinationFolder="$(OutputPath)" SkipUnchangedFiles="true" />
  </Target>

</Project>
